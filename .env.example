# Supabase Configuration (pre-configured — do not change)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# OMDB API Key (optional — for Movie Finder demo)
# Configure this through the Supabase Edge Function secrets, not in frontend code
VITE_OMDB_API_KEY=

# Storage Configuration
# Storage buckets are configured in Supabase:
# - certificates (public read, authenticated write)
# - project-images (public read, authenticated write)

# Contact Form
# Contact messages are stored in the contact_messages table
# and managed through the admin dashboard
